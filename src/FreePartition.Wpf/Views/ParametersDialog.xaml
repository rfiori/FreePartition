<Window x:Class="FreePartition.Wpf.ParametersDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MinWidth="360" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtDescription" FontWeight="SemiBold" Margin="0,0,0,12" TextWrapping="Wrap" MaxWidth="420" />
        <StackPanel x:Name="FieldsPanel" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add to queue" IsDefault="True" Padding="14,4" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
