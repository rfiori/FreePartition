<Window x:Class="FreePartition.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="/Assets/app.ico" Title="FreePartition" Height="720" Width="1180" MinHeight="520" MinWidth="900"
        WindowStartupLocation="CenterScreen" Background="White" Loaded="Window_Loaded" Closing="Window_Closing">

    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#2F6FA8" />
        <SolidColorBrush x:Key="Line" Color="#D9D9D9" />
        <SolidColorBrush x:Key="Hover" Color="#E3EFFA" />
        <SolidColorBrush x:Key="Selection" Color="#CDE5F7" />

        <!-- Toolbar button: icon on top, small text below -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item of the "Operations" list in the left panel -->
        <Style x:Key="OperationItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Icon of "Split partition" (the icon font has nothing like it): two blocks with a double arrow cut out -->
        <CombinedGeometry x:Key="SplitIconGeometry" GeometryCombineMode="Exclude">
            <CombinedGeometry.Geometry1>
                <GeometryGroup>
                    <RectangleGeometry Rect="0.5,1.5,6.9,13" RadiusX="1.6" RadiusY="1.6" />
                    <RectangleGeometry Rect="8.6,1.5,6.9,13" RadiusX="1.6" RadiusY="1.6" />
                </GeometryGroup>
            </CombinedGeometry.Geometry1>
            <CombinedGeometry.Geometry2>
                <PathGeometry Figures="M 1.8,8 L 4.8,5 L 4.8,7.1 L 11.2,7.1 L 11.2,5 L 14.2,8 L 11.2,11 L 11.2,8.9 L 4.8,8.9 L 4.8,11 Z" />
            </CombinedGeometry.Geometry2>
        </CombinedGeometry>

        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Heading of a group of operations in the left panel -->
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#777777" />
            <Setter Property="Margin" Value="8,10,8,2" />
        </Style>

        <Style x:Key="DangerGroupTitle" TargetType="TextBlock" BasedOn="{StaticResource GroupTitle}">
            <Setter Property="Foreground" Value="#B3261E" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#333333" />
        </Style>

        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,5" />
            <Setter Property="Foreground" Value="#444444" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#222222" />
            <Setter Property="Height" Value="24" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Selection}" />
                    <Setter Property="Foreground" Value="Black" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ===================== MENU ===================== -->
        <Menu DockPanel.Dock="Top" Background="White" Padding="2,2">
            <MenuItem Header="General">
                <MenuItem Header="Refresh disks" Click="BtnRefreshDisks_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Apply pending operations" Click="BtnApplyOperations_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Undo all" Click="BtnClearQueue_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="Exit" Click="MenuExit_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="View">
                <MenuItem x:Name="MenuShowLog" Header="Show operations log" IsCheckable="True"
                          Checked="MenuShowLog_Changed" Unchecked="MenuShowLog_Changed">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8A5;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Tools">
                <MenuItem Header="Recover deleted files…" Click="BtnRecoverFiles_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Recover lost partitions…" Click="OpRecoverPartitions_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Disk health (S.M.A.R.T.)…" Click="BtnDiskHealth_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Open log folder" Click="MenuOpenLog_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8B7;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="About" Click="MenuAbout_Click">
                    <MenuItem.Icon>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}"
                                   Width="Auto" HorizontalAlignment="Center" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- ===================== TOOLBAR ===================== -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,1" Padding="6,4">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnUndo" Style="{StaticResource ToolbarButton}" ToolTip="Undo the last pending operation"
                        Click="BtnUndo_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7A7;" FontSize="22" Width="Auto" HorizontalAlignment="Center" />
                        <TextBlock Text="Undo" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnApplyOperations" Style="{StaticResource ToolbarButton}" ToolTip="Apply the pending operations"
                        Click="BtnApplyOperations_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="22" Width="Auto" HorizontalAlignment="Center" />
                        <TextBlock Text="Apply" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRefreshDisks" Style="{StaticResource ToolbarButton}" ToolTip="Reload disks and partitions"
                        Click="BtnRefreshDisks_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="22" Width="Auto" HorizontalAlignment="Center" />
                        <TextBlock Text="Refresh" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource Line}" Margin="8,2" />

                <Button Style="{StaticResource ToolbarButton}" ToolTip="Look for deleted files on an NTFS drive"
                        Click="BtnRecoverFiles_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" FontSize="22" Width="Auto" HorizontalAlignment="Center" />
                        <TextBlock Text="Recover files" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarButton}" ToolTip="Check the S.M.A.R.T. health of the disks"
                        Click="BtnDiskHealth_Click">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE95E;" FontSize="22" Width="Auto" HorizontalAlignment="Center" />
                        <TextBlock Text="Disk health" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- ===================== STATUS BAR ===================== -->
        <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="{StaticResource Line}"
                BorderThickness="0,1,0,0" Padding="8,4">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="TxtVersion" DockPanel.Dock="Right" Foreground="#777777" Margin="12,0,0,0" />

                <!-- Busy indicator: a spinning arc, visible only while something is processing -->
                <Ellipse x:Name="BusySpinner" DockPanel.Dock="Left" Width="12" Height="12" Margin="0,0,8,0"
                         Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="3 3"
                         StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Visibility="Collapsed"
                         VerticalAlignment="Center">
                    <Ellipse.RenderTransform>
                        <RotateTransform x:Name="BusyRotation" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="BusyRotation"
                                                     Storyboard.TargetProperty="Angle"
                                                     From="0" To="360" Duration="0:0:1"
                                                     RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <TextBlock x:Name="TxtDiskStatus" Foreground="#444444" TextTrimming="CharacterEllipsis"
                           Text="We recommend closing all other applications while disk operations are running." />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===================== LEFT PANEL ===================== -->
            <Border Grid.Column="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="150" MinHeight="70" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,8,8,4" Background="#FAFAFA">
                        <TextBlock Text="Operations" Style="{StaticResource SectionTitle}" />
                    </Border>

                    <!-- The list of operations scrolls on short windows so the pending queue below stays visible -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OperationsPanel">
                        <TextBlock Text="INSPECT" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="OpExplore" Style="{StaticResource OperationItem}" Click="OpExplore_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Explore partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpProperties" Style="{StaticResource OperationItem}" Click="OpProperties_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Properties" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpVerifyWipe" Style="{StaticResource OperationItem}" Click="OpVerifyWipe_Click"
                                ToolTip="Read the whole volume (read-only) and check that nothing is left after a wipe">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Verify wipe" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpClusterMap" Style="{StaticResource OperationItem}" Click="OpClusterMap_Click"
                                ToolTip="Draw the volume as a grid and look at the bytes of any square (read-only)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xF0E2;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Cluster map" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpRecover" Style="{StaticResource OperationItem}" Click="BtnRecoverFiles_Click"
                                Background="#D9F0DF" ToolTip="Look for deleted files on the selected drive (NTFS)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Recover files" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpRecoverPartitions" Style="{StaticResource OperationItem}" Click="OpRecoverPartitions_Click"
                                ToolTip="Look for partitions missing from the partition table and put them back (read-only until you click Apply)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Recover partitions" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="CREATE" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="OpInitialize" Style="{StaticResource OperationItem}" Click="OpInitialize_Click"
                                ToolTip="Initialize the selected blank disk as MBR or GPT">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Initialize disk" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpCreate" Style="{StaticResource OperationItem}" Click="OpCreate_Click"
                                ToolTip="Create a partition in the selected unallocated space">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Create partition" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="SIZE AND POSITION" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="OpResize" Style="{StaticResource OperationItem}" Click="OpResize_Click"
                                ToolTip="Extend or shrink the selected partition">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Resize partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpMove" Style="{StaticResource OperationItem}" Click="OpMove_Click"
                                ToolTip="Move the selected partition into free space on the same disk (data is lost if interrupted)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AB;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Move partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpAlign" Style="{StaticResource OperationItem}" Click="OpAlign_Click"
                                ToolTip="Move a partition that is not aligned to 4 KB to the nearest 1 MB boundary (data is lost if interrupted)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8E4;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Align partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpMerge" Style="{StaticResource OperationItem}" Click="OpMerge_Click"
                                ToolTip="Merge the selected partition into the one right before it (its files are kept in a folder)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8B5;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Merge partitions" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpSplit" Style="{StaticResource OperationItem}" Click="OpSplit_Click"
                                ToolTip="Split the selected partition in two, using its free space">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource SplitIconGeometry}" Fill="{StaticResource Accent}"
                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Split partition" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="SETTINGS" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="OpLabel" Style="{StaticResource OperationItem}" Click="OpLabel_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8AC;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Change label" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpLetter" Style="{StaticResource OperationItem}" Click="OpLetter_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Change letter" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpConvert" Style="{StaticResource OperationItem}" Click="OpConvert_Click"
                                ToolTip="Convert the selected partition between FAT32 and NTFS keeping its files">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Convert FAT32 / NTFS" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpActive" Style="{StaticResource OperationItem}" Click="OpActive_Click"
                                ToolTip="Mark the selected MBR partition as active (bootable)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Set active" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpHide" Style="{StaticResource OperationItem}" Click="OpHide_Click"
                                ToolTip="Remove the drive letter; the data stays untouched">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xED1A;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Hide partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpShow" Style="{StaticResource OperationItem}" Click="OpShow_Click"
                                ToolTip="Give a drive letter to a hidden partition">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Show partition" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="MAINTENANCE" Style="{StaticResource GroupTitle}" />
                        <Button x:Name="OpCheck" Style="{StaticResource OperationItem}" Click="OpCheck_Click"
                                ToolTip="Check the selected volume for file system errors (chkdsk)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9D9;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Check for errors" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="DESTRUCTIVE" Style="{StaticResource DangerGroupTitle}" />
                        <Button x:Name="OpFormat" Style="{StaticResource OperationItem}" Click="OpFormat_Click"
                                ToolTip="Erases all data on the partition">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Format partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpDelete" Style="{StaticResource OperationItem}" Click="OpDelete_Click"
                                ToolTip="Erases all data on the partition">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Delete partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpWipeFree" Style="{StaticResource OperationItem}" Click="OpWipeFree_Click"
                                ToolTip="Overwrite the free space of the selected drive so deleted files cannot be recovered (files are kept)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE894;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Wipe free space" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpWipe" Style="{StaticResource OperationItem}" Click="OpWipe_Click"
                                ToolTip="Overwrite every sector of the selected partition so nothing on it can be recovered">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE75C;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Wipe partition" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="OpWipeDisk" Style="{StaticResource OperationItem}" Click="OpWipeDisk_Click"
                                ToolTip="Delete every partition of the selected disk and overwrite all of its sectors">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" Foreground="{StaticResource Accent}" />
                                <TextBlock Text="Wipe disk" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="8,8,8,4"
                            Background="#FAFAFA">
                        <TextBlock Text="Pending operations" Style="{StaticResource SectionTitle}" />
                    </Border>

                    <StackPanel Grid.Row="4" Margin="8">
                        <!-- Simulation on = safe (amber); off = changes are real (red) -->
                        <CheckBox x:Name="ChkSimulation" IsChecked="True" FontWeight="Bold">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Simulation (does not execute)" />
                                        <Setter Property="Foreground" Value="#C26A00" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=ChkSimulation}" Value="False">
                                                <Setter Property="Text" Value="REAL MODE: changes the disk!" />
                                                <Setter Property="Foreground" Value="#C62828" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button x:Name="BtnClearQueue" Content="Undo all" Padding="10,3" Click="BtnClearQueue_Click" />
                            <Button x:Name="BtnCancelOperations" Content="Cancel" Padding="10,3" Margin="6,0,0,0"
                                    IsEnabled="False" Click="BtnCancelOperations_Click" />
                        </StackPanel>
                    </StackPanel>

                    <ListBox x:Name="PendingList" Grid.Row="3" BorderThickness="0" Margin="0,4,0,0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="2,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Order, Mode=OneWay}" />
                                        <Run Text=". " />
                                        <Run Text="{Binding Operation.Description, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Operation.RiskText, Mode=OneWay}" FontSize="11" Foreground="#B45309" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- ===================== CENTER AREA ===================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="210" MinHeight="110" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid x:Name="DisksGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single"
                          SelectionUnit="FullRow" BorderThickness="0" Background="White"
                          SelectionChanged="DisksGrid_SelectionChanged"
                          PreviewMouseRightButtonDown="DisksGrid_RightClick">
                    <DataGrid.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <StackPanel>
                                                    <Border Padding="4,8,4,3" Background="White">
                                                        <DockPanel>
                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;"
                                                                       Foreground="{StaticResource Accent}" FontSize="16" />
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center" Margin="4,0,8,0" />
                                                            <Border Height="1" Background="{StaticResource Line}"
                                                                    VerticalAlignment="Center" />
                                                        </DockPanel>
                                                    </Border>
                                                    <ItemsPresenter />
                                                </StackPanel>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </DataGrid.GroupStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Partition" Binding="{Binding Name}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="File System" Binding="{Binding FileSystem}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="Capacity" Binding="{Binding Capacity}" Width="Auto" MinWidth="70"
                                            ElementStyle="{StaticResource Number}" />
                        <DataGridTextColumn Header="Used" Binding="{Binding Used}" Width="Auto" MinWidth="70"
                                            ElementStyle="{StaticResource Number}" />
                        <DataGridTextColumn Header="Unused" Binding="{Binding Unused}" Width="Auto" MinWidth="70"
                                            ElementStyle="{StaticResource Number}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="Auto" MinWidth="70" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="#EFEFEF" />

                <!-- Graphical disk map -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#F3F3F3">
                    <StackPanel x:Name="DiskMap" Margin="8,8,8,4" />
                </ScrollViewer>

                <!-- Operations log (shown when applying or via the View menu) -->
                <TextBox x:Name="TxtOperationsLog" Grid.Row="3" Height="110" IsReadOnly="True" Visibility="Collapsed"
                         VerticalScrollBarVisibility="Auto" FontFamily="Consolas" TextWrapping="Wrap"
                         BorderThickness="0,1,0,0" BorderBrush="{StaticResource Line}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
