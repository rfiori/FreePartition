<Window x:Class="FreePartition.Wpf.ClusterMapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreePartition.Wpf"
        Title="Cluster map" Width="700" Height="760" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnStart" Content="Scan" Padding="22,4" Click="Start_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Padding="18,4" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
            <Button Content="Close" IsCancel="True" Padding="26,4" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="TxtSubtitle" Foreground="DimGray" Margin="0,2,0,0" />
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,10,0,0"
                       Text="Draws the whole volume as a grid. Each square is classified from three 4 KB samples (start, middle and end), so a green square can still hide data between the samples: use Verify wipe to read everything. Click a square to see its bytes." />
            <ProgressBar x:Name="Bar" Height="14" Margin="0,12,0,0" Minimum="0" Maximum="1" />
            <TextBlock x:Name="TxtStatus" Foreground="DimGray" Margin="0,4,0,0" />
            <WrapPanel x:Name="Legend" Margin="0,6,0,6" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="120" />
            </Grid.RowDefinitions>
            <Border BorderBrush="#BCBCBC" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <local:ClusterGrid x:Name="CellGrid" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Border>
            <TextBlock x:Name="TxtCell" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,4" FontWeight="SemiBold" />
            <TextBox x:Name="TxtDump" Grid.Row="2" IsReadOnly="True" FontFamily="Consolas" FontSize="11"
                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F7F7F7" />
        </Grid>
    </DockPanel>
</Window>
