<Window x:Class="FreePartition.Wpf.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" Width="520" Height="440" MinWidth="420" MinHeight="340"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White" Closing="Window_Closing">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnInstall" Content="Update now" IsDefault="True" Padding="18,4" Click="Install_Click" />
            <Button x:Name="BtnSkip" Content="Skip this version" Padding="14,4" Margin="8,0,0,0" Click="Skip_Click" />
            <Button x:Name="BtnLater" Content="Later" IsCancel="True" Padding="22,4" Margin="8,0,0,0" Click="Later_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ProgressBar x:Name="Bar" Height="14" Minimum="0" Maximum="1" Visibility="Collapsed" />
            <TextBlock x:Name="TxtStatus" Foreground="DimGray" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold" Foreground="#2F6FA8" />
            <TextBlock x:Name="TxtSubtitle" Foreground="DimGray" Margin="0,2,0,8" TextWrapping="Wrap" />
            <TextBlock Text="What's new" FontWeight="SemiBold" Margin="0,0,0,4" />
        </StackPanel>

        <TextBox x:Name="TxtNotes" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="#F7F7F7" BorderBrush="#DDD" Padding="6" />
    </DockPanel>
</Window>
