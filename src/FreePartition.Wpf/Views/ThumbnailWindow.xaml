<Window x:Class="FreePartition.Wpf.ThumbnailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thumbnails" Height="640" Width="900" MinHeight="300" MinWidth="500"
        WindowStartupLocation="CenterOwner" Background="White" Closed="Window_Closed">
    <DockPanel Margin="12">

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="0,0,6,0" />
                <Slider x:Name="SldSize" Width="140" Minimum="80" Maximum="320" Value="160" VerticalAlignment="Center"
                        TickFrequency="20" IsSnapToTickEnabled="True" ValueChanged="SldSize_ValueChanged" />
            </StackPanel>
            <Button Content="Check all" Padding="12,3" Click="BtnCheckAll_Click" />
            <Button Content="Uncheck all" Padding="12,3" Margin="8,0,0,0" Click="BtnUncheckAll_Click" />
            <TextBlock x:Name="TxtSummary" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#555555" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Done" Padding="18,4" IsDefault="True" Click="BtnDone_Click" />
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Foreground="#666666" />
        </DockPanel>

        <!-- Clicking, dragging and Shift+click are handled in code-behind and drive the check boxes, so the list's own selection is switched off -->
        <ListBox x:Name="Items" BorderThickness="1" BorderBrush="#D9D9D9" SelectionMode="Single"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                 PreviewMouseLeftButtonDown="Items_PreviewMouseLeftButtonDown"
                 PreviewMouseMove="Items_PreviewMouseMove"
                 PreviewMouseLeftButtonUp="Items_PreviewMouseLeftButtonUp"
                 LostMouseCapture="Items_LostMouseCapture">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Width="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                          ToolTip="{Binding ToolTip}" Margin="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Background="#F3F3F3"
                                Height="{Binding CellWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="2" />
                                <TextBlock Text="{Binding Placeholder}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" TextWrapping="Wrap" Margin="6" Foreground="#888888" FontSize="11" />
                            </Grid>
                        </Border>
                        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}"
                                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" />

                        <TextBlock Grid.Row="1" Text="{Binding Caption}" TextTrimming="CharacterEllipsis" FontSize="11"
                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
