<Window x:Class="FreePartition.Wpf.LostPartitionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover lost partitions" Width="720" Height="560" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="BtnStart" Content="Scan" Padding="22,4" Click="Start_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Padding="18,4" Margin="8,0,0,0" IsEnabled="False" Click="Cancel_Click" />
            <Button x:Name="BtnRestore" Content="Add to queue" Padding="14,4" Margin="8,0,0,0" IsEnabled="False" Click="Restore_Click"
                    ToolTip="Queue the checked partitions; nothing is written until you click Apply" />
            <Button Content="Close" IsCancel="True" Padding="26,4" Margin="8,0,0,0" Click="Close_Click" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Disk to scan:" FontWeight="SemiBold" />
            <ComboBox x:Name="CmbDisks" Margin="0,4,0,0" SelectionChanged="CmbDisks_SelectionChanged" />
            <TextBlock TextWrapping="Wrap" Foreground="#555" Margin="0,12,0,0"
                       Text="Looks for the boot sector of NTFS, FAT32 and exFAT partitions in the space no partition covers (read-only), and puts the ones you check back in the partition table. Only the table is written: the files are not touched." />
            <Border x:Name="NoteBox" Visibility="Collapsed" Background="#FFF3CD" BorderBrush="#E0C060" BorderThickness="1"
                    Padding="10,8" Margin="0,10,0,0">
                <TextBlock x:Name="TxtNote" TextWrapping="Wrap" />
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton x:Name="RbQuick" Content="Quick" IsChecked="True" VerticalAlignment="Center"
                             ToolTip="Looks where partitions usually start (every 1 MB and the old track and cylinder boundaries)" />
                <RadioButton x:Name="RbDeep" Content="Deep (reads every sector of the free space; much slower)" Margin="16,0,0,0"
                             VerticalAlignment="Center" ToolTip="Finds partitions that start anywhere" />
            </StackPanel>
            <ProgressBar x:Name="Bar" Height="18" Margin="0,12,0,0" Minimum="0" Maximum="1" />
            <TextBlock x:Name="TxtStatus" Foreground="DimGray" Margin="0,4,0,8" TextWrapping="Wrap" />
        </StackPanel>

        <ListView x:Name="ResultsList" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Width="34">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanRestore}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="File system" Width="90" DisplayMemberBinding="{Binding FileSystem}" />
                    <GridViewColumn Header="Size" Width="90" DisplayMemberBinding="{Binding Size}" />
                    <GridViewColumn Header="Serial" Width="130" DisplayMemberBinding="{Binding Serial}" />
                    <GridViewColumn Header="Confidence" Width="230" DisplayMemberBinding="{Binding Confidence}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
