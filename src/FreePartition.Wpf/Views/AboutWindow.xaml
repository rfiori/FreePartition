<Window x:Class="FreePartition.Wpf.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About FreePartition" SizeToContent="Height" Width="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <StackPanel Margin="18">

        <TextBlock Text="FreePartition" FontSize="20" FontWeight="SemiBold" Foreground="#2F6FA8" />
        <TextBlock Margin="0,2,0,0" TextWrapping="Wrap" Foreground="#555"
                   Text="A free disk partition manager for Windows, with NTFS deleted-file recovery." />

        <Separator Margin="0,14,0,10" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" MinWidth="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Version" Foreground="#555" Margin="0,0,0,4" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtVersion" Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Runtime" Foreground="#555" Margin="0,0,0,4" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtRuntime" Margin="0,0,0,4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Operating system" Foreground="#555" Margin="0,0,0,4" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtOs" Margin="0,0,0,4" TextWrapping="Wrap" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Running as" Foreground="#555" Margin="0,0,0,4" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtElevation" Margin="0,0,0,4" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Repository" Foreground="#555" Margin="0,0,0,4" />
            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,4">
                <Hyperlink NavigateUri="https://github.com/rfiori/FreePartition"
                           RequestNavigate="Link_RequestNavigate">github.com/rfiori/FreePartition</Hyperlink>
            </TextBlock>

            <TextBlock Grid.Row="5" Grid.Column="0" Text="License" Foreground="#555" />
            <TextBlock Grid.Row="5" Grid.Column="1" TextWrapping="Wrap">
                <Run Text="MIT — " /><Hyperlink
                    NavigateUri="https://github.com/rfiori/FreePartition/blob/main/LICENSE"
                    RequestNavigate="Link_RequestNavigate">read the full text</Hyperlink>
            </TextBlock>
        </Grid>

        <Separator Margin="0,12,0,10" />

        <TextBlock Text="Safety" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Foreground="#333" LineHeight="18"
                   Text="• Nothing is written to a disk until you click Apply.&#x0a;• Simulation mode is checked by default — it only shows the commands.&#x0a;• Volumes are opened read-only during a scan; recovery always writes to another drive.&#x0a;• Formatting or relettering the Windows drive is blocked." />

        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
            <Run Text="Operations log: " Foreground="#555" /><Hyperlink
                x:Name="LinkLog" RequestNavigate="Link_RequestNavigate">open folder</Hyperlink>
        </TextBlock>

        <Border Background="#FFF6E5" BorderBrush="#E8C77A" BorderThickness="1" CornerRadius="3"
                Padding="10,8" Margin="0,12,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#5B4612"
                       Text="Alpha software that touches disks. Try it on a test VHD or a virtual machine first, and keep backups." />
        </Border>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11" Foreground="#777"
                   x:Name="TxtCopyright" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Copy details" Padding="12,4" Click="Copy_Click" />
            <Button Content="OK" IsDefault="True" IsCancel="True" Padding="22,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
