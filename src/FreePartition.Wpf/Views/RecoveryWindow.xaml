<Window x:Class="FreePartition.Wpf.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover deleted files" Height="600" Width="1180" MinHeight="400" MinWidth="900"
        WindowStartupLocation="CenterOwner" Background="White" Closing="Window_Closing" Closed="Window_Closed">
    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#B45309">
            Read-only on the source disk. Always recover to ANOTHER disk.
        </TextBlock>

        <Border x:Name="TrimWarning" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8" Padding="8,6"
                Background="#FDECEC" BorderBrush="#C0392B" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" Foreground="#922B21">
                <Run FontWeight="SemiBold">This drive is on an SSD.</Run>
                Windows normally sends TRIM when a file is deleted, so the SSD erases those blocks and the deleted files
                are usually gone for good. A scan can still list names, but the data is likely zeroed out.
                Stop using this drive now: every write lowers the chance further.
            </TextBlock>
        </Border>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive:" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbDrives" Width="80" Margin="8,0,0,0" SelectionChanged="CmbDrives_SelectionChanged" />
            <CheckBox x:Name="ChkCarve" Content="Carve files by signature" VerticalAlignment="Center" Margin="16,0,0,0"
                      ToolTip="Searches the whole drive for known file types by their content (photos, video, audio, documents, archives, databases, programs), ignoring the file system. Slower, and the files come back without their names and folders. Always used on FAT/exFAT and when the NTFS MFT is damaged."
                      Checked="ChkCarve_Changed" Unchecked="ChkCarve_Changed" />
            <Button x:Name="BtnScan" Content="Scan" Padding="14,4" Margin="12,0,0,0" Click="BtnScan_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Padding="14,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="BtnCancel_Click" />
        </StackPanel>

        <TextBlock x:Name="TxtCarveNote" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap"
                   Margin="0,0,0,8" Foreground="#555555" />

        <Border DockPanel.Dock="Top" Margin="0,0,0,10" Padding="12,8,12,10" Background="#F7F7F7"
                BorderBrush="#D9D9D9" BorderThickness="1" CornerRadius="3">
            <Border.Resources>
                <Style TargetType="TextBlock" x:Key="FieldLabel">
                    <Setter Property="Foreground" Value="#555555" />
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Margin" Value="0,0,0,3" />
                </Style>
                <Style TargetType="TextBox">
                    <Setter Property="Height" Value="26" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="ComboBox">
                    <Setter Property="Height" Value="26" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
                <Style TargetType="DatePicker">
                    <Setter Property="Height" Value="26" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Border.Resources>

            <WrapPanel>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Name contains" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="TxtFilter" Width="190" TextChanged="TxtFilter_TextChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="CmbCategory" Width="120" SelectionChanged="Filter_Changed" />
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Size" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TxtMinSize" Width="60" ToolTip="Minimum size" TextChanged="Filter_Changed" />
                        <ComboBox x:Name="CmbMinUnit" Width="58" Margin="4,0,0,0" SelectionChanged="Filter_Changed" />
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="8,0" />
                        <TextBox x:Name="TxtMaxSize" Width="60" ToolTip="Maximum size" TextChanged="Filter_Changed" />
                        <ComboBox x:Name="CmbMaxUnit" Width="58" Margin="4,0,0,0" SelectionChanged="Filter_Changed" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="Modified" Style="{StaticResource FieldLabel}" />
                    <StackPanel Orientation="Horizontal">
                        <DatePicker x:Name="DateFrom" Width="150" ToolTip="From date" SelectedDateChanged="Filter_Changed" />
                        <TextBlock Text="–" VerticalAlignment="Center" Margin="8,0" />
                        <DatePicker x:Name="DateTo" Width="150" ToolTip="To date" SelectedDateChanged="Filter_Changed" />
                    </StackPanel>
                </StackPanel>

                <Button Content="Clear filters" Padding="12,0" Height="26" VerticalAlignment="Bottom"
                        Click="BtnClearFilters_Click" />
            </WrapPanel>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="BtnRecover" DockPanel.Dock="Right" Content="Recover checked…"
                        Padding="14,4" IsEnabled="False" Click="BtnRecover_Click" />
                <TextBlock x:Name="TxtFileStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="350" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="520" MinWidth="200" />
            </Grid.ColumnDefinitions>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- Preview of the selected file (read-only); wide enough for a 16-byte hex line -->
            <DockPanel Grid.Column="2">
                <TextBlock Text="Preview" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,4" Background="#F3F3F3" />
                <TextBlock x:Name="TxtPreviewInfo" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,4,0,0"
                           Foreground="#666666" />
                <Border BorderThickness="1" BorderBrush="#D9D9D9">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform" Visibility="Collapsed" Margin="4" />
                        <TextBox x:Name="TxtPreview" IsReadOnly="True" BorderThickness="0" Visibility="Collapsed"
                                 FontFamily="Consolas" FontSize="11" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </DockPanel>

            <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers; the right margin leaves room for the tree's scroll bar -->
            <DockPanel Grid.Row="0" Background="#F3F3F3" Margin="0,0,0,0" TextBlock.FontWeight="SemiBold">
                <Border Width="20" DockPanel.Dock="Right" />
                <TextBlock Text="Chance" Width="135" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Modified" Width="120" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Size" Width="90" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Name" Margin="26,4" />
            </DockPanel>

            <TreeView x:Name="FilesTree" Grid.Row="1" BorderThickness="1" BorderBrush="#D9D9D9"
                      SelectedItemChanged="FilesTree_SelectedItemChanged"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- Custom template: the default one sizes the header to its content, which breaks column alignment -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Bd" Background="Transparent">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="Exp" DockPanel.Dock="Left" Width="16" Focusable="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="9" Foreground="#555555"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter ContentSource="Header" />
                                            </DockPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="Items" Margin="16,0,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="Items" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Exp" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DCE9F5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock Text="{Binding ChanceText}" Width="135" DockPanel.Dock="Right" Margin="4,0" />
                            <TextBlock Text="{Binding ModifiedText}" Width="120" DockPanel.Dock="Right" Margin="4,0" />
                            <TextBlock Text="{Binding SizeText}" Width="90" DockPanel.Dock="Right" Margin="4,0" />
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanCheck}" IsThreeState="True"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#2F6FA8"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
