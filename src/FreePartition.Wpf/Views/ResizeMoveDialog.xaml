<Window x:Class="FreePartition.Wpf.ResizeMoveDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreePartition.Wpf"
        Title="Resize/Move partition" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtDescription" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock x:Name="TxtHint" Foreground="DimGray" TextWrapping="Wrap" Margin="0,0,0,12" />

        <ContentPresenter x:Name="BarHost" />

        <Border x:Name="MoveNote" Visibility="Collapsed" Background="#EEF4FB" BorderBrush="#A9C4E4"
                BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="TxtMoveNote" TextWrapping="Wrap" />
        </Border>

        <Border x:Name="LimitNote" Visibility="Collapsed" Background="#FFF4CE" BorderBrush="#E0B84C"
                BorderThickness="1" Padding="10" Margin="0,12,0,0">
            <TextBlock x:Name="TxtLimit" TextWrapping="Wrap" />
        </Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Free space before:" VerticalAlignment="Center" />
            <local:SizeInput x:Name="InputBefore" Grid.Column="1" Margin="8,0,0,0" />

            <TextBlock Grid.Row="1" Text="Partition size:" VerticalAlignment="Center" Margin="0,6,0,0" />
            <local:SizeInput x:Name="InputSize" Grid.Row="1" Grid.Column="1" Margin="8,6,0,0" />

            <TextBlock Grid.Row="2" Text="Free space after:" VerticalAlignment="Center" Margin="0,6,0,0" />
            <local:SizeInput x:Name="InputAfter" Grid.Row="2" Grid.Column="1" Margin="8,6,0,0" />

            <TextBlock x:Name="TxtDelta" Grid.RowSpan="3" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                       Foreground="DimGray" TextWrapping="Wrap" />
        </Grid>

        <Border x:Name="PowerWarning" Visibility="Collapsed" Background="#FFF4CE" BorderBrush="#E0B84C"
                BorderThickness="1" Padding="10" Margin="0,14,0,0">
            <TextBlock x:Name="TxtWarning" TextWrapping="Wrap" />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add to queue" IsDefault="True" Padding="14,4" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
