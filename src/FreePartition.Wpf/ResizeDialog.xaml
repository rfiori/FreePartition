<Window x:Class="FreePartition.Wpf.ResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FreePartition.Wpf"
        Title="Resize partition" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="TxtDescription" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock Text="Drag the handle to shrink or extend the partition." Foreground="DimGray" Margin="0,0,0,12" />

        <local:PartitionBar x:Name="Bar" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="New size:" VerticalAlignment="Center" />
            <local:SizeInput x:Name="InputSize" Width="170" Margin="8,0,0,0" />
            <TextBlock x:Name="TxtDelta" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="DimGray" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Add to queue" IsDefault="True" Padding="14,4" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Padding="14,4" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
