<Window x:Class="FreePartition.Wpf.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recover deleted files" Height="620" Width="1000" MinHeight="400" MinWidth="700"
        WindowStartupLocation="CenterOwner" Background="White" Closed="Window_Closed">
    <DockPanel Margin="12">

        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8" Foreground="#B45309">
            Read-only on the source disk. Always recover to ANOTHER disk.
            On SSDs with TRIM enabled, deleted files are usually zeroed out and cannot be recovered.
        </TextBlock>

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Drive (NTFS):" VerticalAlignment="Center" />
            <ComboBox x:Name="CmbDrives" Width="80" Margin="8,0,0,0" />
            <Button x:Name="BtnScan" Content="Scan" Padding="14,4" Margin="12,0,0,0" Click="BtnScan_Click" />
            <Button x:Name="BtnCancel" Content="Cancel" Padding="14,4" Margin="8,0,0,0"
                    IsEnabled="False" Click="BtnCancel_Click" />
            <TextBlock Text="Filter by name:" VerticalAlignment="Center" Margin="24,0,0,0" />
            <TextBox x:Name="TxtFilter" Width="200" Margin="8,0,0,0" TextChanged="TxtFilter_TextChanged" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" />
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="BtnRecover" DockPanel.Dock="Right" Content="Recover checked…"
                        Padding="14,4" IsEnabled="False" Click="BtnRecover_Click" />
                <TextBlock x:Name="TxtFileStatus" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Column headers; the right margin leaves room for the tree's scroll bar -->
            <DockPanel Grid.Row="0" Background="#F3F3F3" Margin="0,0,0,0" TextBlock.FontWeight="SemiBold">
                <Border Width="20" DockPanel.Dock="Right" />
                <TextBlock Text="Chance" Width="100" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Modified" Width="120" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Size" Width="90" DockPanel.Dock="Right" Margin="4,4" />
                <TextBlock Text="Name" Margin="26,4" />
            </DockPanel>

            <TreeView x:Name="FilesTree" Grid.Row="1" BorderThickness="1" BorderBrush="#D9D9D9"
                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- Custom template: the default one sizes the header to its content, which breaks column alignment -->
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="Bd" Background="Transparent">
                                            <DockPanel LastChildFill="True">
                                                <ToggleButton x:Name="Exp" DockPanel.Dock="Left" Width="16" Focusable="False"
                                                              ClickMode="Press"
                                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                    <ToggleButton.Template>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border Background="Transparent">
                                                                <TextBlock x:Name="Glyph" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets"
                                                                           FontSize="9" Foreground="#555555"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </ToggleButton.Template>
                                                </ToggleButton>
                                                <ContentPresenter ContentSource="Header" />
                                            </DockPanel>
                                        </Border>
                                        <ItemsPresenter x:Name="Items" Margin="16,0,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="Items" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="HasItems" Value="False">
                                            <Setter TargetName="Exp" Property="Visibility" Value="Hidden" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#DCE9F5" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <DockPanel LastChildFill="True" Margin="0,1">
                            <TextBlock Text="{Binding ChanceText}" Width="100" DockPanel.Dock="Right" Margin="4,0" />
                            <TextBlock Text="{Binding ModifiedText}" Width="120" DockPanel.Dock="Right" Margin="4,0" />
                            <TextBlock Text="{Binding SizeText}" Width="90" DockPanel.Dock="Right" Margin="4,0" />
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsThreeState="True"
                                      VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" Foreground="#2F6FA8"
                                       VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        </DockPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>
    </DockPanel>
</Window>
