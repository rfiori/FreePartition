<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>FreePartition.Wpf</RootNamespace>
    <AssemblyName>FreePartition</AssemblyName>
    <!-- The app needs administrator rights to open the raw volume (\\.\C:) -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/app.ico" />
    <ProjectReference Include="..\FreePartition.Core\FreePartition.Core.csproj" />
  </ItemGroup>

</Project>
