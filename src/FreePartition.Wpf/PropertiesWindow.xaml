<Window x:Class="FreePartition.Wpf.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Properties" Width="580" Height="700" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Copy details" Padding="14,4" Click="Copy_Click" />
            <Button Content="OK" IsDefault="True" IsCancel="True" Padding="26,4" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TxtTitle" FontSize="20" FontWeight="SemiBold" />
                <TextBlock x:Name="TxtSubtitle" Foreground="DimGray" Margin="0,2,0,0" />

                <StackPanel x:Name="UsagePanel" Margin="0,16,0,0" Width="472" HorizontalAlignment="Center">
                    <Border BorderBrush="#9AB8D6" BorderThickness="1" Height="30" Background="#F3F3F3" Width="469">
                        <Grid x:Name="BarGrid" />
                    </Border>
                    <WrapPanel x:Name="Legend" Margin="0,10,0,0" />
                    <TextBlock x:Name="TxtScan" FontSize="11" Foreground="#777" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel x:Name="InfoPanel" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
