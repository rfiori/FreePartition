# Normalize text files in the repository and check them out with CRLF.
# This project is Windows-only, so CRLF in the working tree is the right default
# and the result no longer depends on each machine's core.autocrlf setting.
* text=auto eol=crlf

# Files that must never be converted.
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.dll binary
*.exe binary
*.vhd binary
*.vhdx binary
